# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
SWAGGER_ENABLED=true

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/alphavista
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/alphavista?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/alphavista

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
# Either set REDIS_URL (preferred for managed Redis like Upstash/Render Redis)
# or the individual host/port/password fields.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_...
# The HMAC secret shown on your Paystack dashboard → Settings → Webhooks
PAYSTACK_WEBHOOK_SECRET=

# ─── Flutterwave ──────────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=FLWSECK_...
FLUTTERWAVE_ENCRYPTION_KEY=

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# ─── Geolocation ──────────────────────────────────────────────────────────────
# provider: ipapi | ipinfo
GEO_PROVIDER=ipapi
# ipapi.co — free tier: 1000 req/day, no token needed; paid plans use a token
IPAPI_TOKEN=
# ipinfo.io token (alternative)
IPINFO_TOKEN=

# ─── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@mail.alphavista.ng

# ─── Google OAuth (Sheets sync) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Storefront URL (used in email links + payment redirect) ──────────────────
STOREFRONT_URL=http://localhost:3000

# ─── WhatsApp (click-to-chat — PRD §1.8 launch tier) ─────────────────────────
# International format without '+', e.g. 2348012345678
# Used to generate wa.me links in order confirmations and custom order receipts.
# Upgrade to Business API (360dialog/Twilio) in a future phase when order volume
# makes manual status updates a drain on staff time.
WHATSAPP_NUMBER=2348000000000
WHATSAPP_SUPPORT_MESSAGE=Hi, I need help with my Labi order.

# ─── Stripe (international cards — behind feature flag) ───────────────────────
# See PRD §1.11 and ASSUMPTIONS.md before enabling.
# Requires a Stripe-supported entity and bank account outside Nigeria.
# STRIPE_ENABLED=false means non-NGN checkout falls back to Flutterwave.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Shipping (quotes, SLA, signed pay links) ─────────────────────────────────
# Hours within which an admin must submit a shipping quote
SHIPPING_QUOTE_SLA_HOURS=24
# Default validity window (days) for a submitted quote
SHIPPING_QUOTE_VALID_DAYS=7
# Comma-separated admin emails that receive quote-request + SLA alerts
ADMIN_ALERT_EMAILS=admin@labi.ng
# HMAC secret for signing guest pay links (generate a long random string)
ORDER_LINK_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
# Upper limit on a single quote amount in NGN kobo (default ₦500,000)
SHIPPING_QUOTE_AMOUNT_CAP=50000000
